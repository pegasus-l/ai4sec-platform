# repro 服务:opencode serve 后端
# 供 TriggerReproStep 调 /session + /session/{id}/message 做项目复现
# opencode-ai@1.15.12 + 模型配置(deepseek-v4-flash-0731)直接复用已验证的 repro-runner:v3
FROM node:20-slim

# nginx: repro-web 多服务总机(常驻 8080, 按 /task/{id}/ 分发到各任务端口)。
# python3-pip/venv: 任务服务依赖走 volume 内持久 venv, 需要能 python3 -m venv + pip install。
# libgomp1: ML 库运行依赖(lightgbm 等需要 libgomp.so.1), 任务服务重启必缺。
# 这些都曾在运行期手动 apt install, 重建容器即丢失 —— 现固化进镜像。
RUN apt-get update && apt-get install -y --no-install-recommends git python3 python3-pip python3-venv curl nginx libgomp1 && rm -rf /var/lib/apt/lists/*

# opencode 1.15.12(已编译 ELF + 自带依赖,与沙箱镜像同版本,serve API 一致)
COPY --from=repro-runner:v3 /usr/lib/node_modules/opencode-ai /usr/lib/node_modules/opencode-ai
RUN ln -sf ../lib/node_modules/opencode-ai/bin/opencode.exe /usr/bin/opencode

# 模型配置:provider alibaba-cn(baseURL 覆盖为 DEEPSEEK 网关 https://az.gptplus5.com/v1)+ deepseek-v4-flash-0731
COPY repro-auth.json /root/.local/share/opencode/auth.json
COPY repro-model.json /root/.local/state/opencode/model.json

# repro-web 多服务总机脚本(register.py/watchdog.py/watchdog.sh/nginx配置):
# 打进镜像, 供 compose 启动命令在全新 volume 时种子化到 /workspace/.repro-web。
# 版本见 /opt/ai-security-fusion-v2/repro-web (git repo)。
COPY repro-web/ /opt/repro-web/

WORKDIR /workspace
ENV OPENCODE_SERVER_HOSTNAME=0.0.0.0
ENV OPENCODE_SERVER_PORT=4096
EXPOSE 4096
CMD ["opencode", "serve", "--hostname", "0.0.0.0", "--port", "4096"]

# 权限: headless serve 无交互应答——克隆到工作区外(/tmp 等)会触发 external_directory
# 权限询问并永久阻塞。容器可丢弃且不挂宿主资源,auto-allow 安全。不配此项则复现卡死。
# opencode 配置: permission allow(避免 external_directory 卡死)
#  + provider.alibaba-cn.options.baseURL/apiKey 覆盖到可用的 DEEPSEEK 网关(原阿里云 key 已 401)
#  + 补 deepseek-v4-flash-0731 模型条目(该模型不在 models.dev 目录里, 不补会 ProviderModelNotFoundError)
COPY repro-opencode.jsonc /root/.config/opencode/opencode.jsonc
