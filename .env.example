# Copy to .env for local development. Never place the token value in this file.
# The path must point to a regular 0600 file visible at the same absolute path
# to both the Repro Worker and the host Docker daemon.
REPRO_MODEL_TOKEN_FILE=/var/lib/ai4sec/secrets/repro_model_token
REPRO_LLM_BASE_URL=https://your-managed-model-gateway.example/v1
REPRO_LLM_MODEL=glm-5.2
REPRO_IMAGE=repro-runner:v4

# Capability reproduction resource limits.
REPRO_CPUS=2.0
REPRO_MEMORY=4g
REPRO_MEMORY_SWAP=4g
REPRO_PIDS_LIMIT=1024

# Leave empty for same-origin deployments. When a separate trusted frontend
# origin is required, use a comma-separated list without paths or wildcards.
AI4SEC_CORS_ALLOWED_ORIGINS=

# Readiness uses a rolled-back real database write with a short lock timeout.
AI4SEC_READINESS_WRITE_TIMEOUT_MS=1000

# SQLite backup retention: all daily backups for 7 days, then one per week for
# 4 weeks and one per month for 6 months. Backups still need an external disk.
AI4SEC_BACKUP_DAILY_RETENTION_DAYS=7
AI4SEC_BACKUP_WEEKLY_RETENTION_WEEKS=4
AI4SEC_BACKUP_MONTHLY_RETENTION_MONTHS=6

# Pipeline Worker renews each running job lease on heartbeat. Lease is forced
# to at least three heartbeat intervals to avoid transient SQLite stalls.
AI4SEC_PIPELINE_WORKER_HEARTBEAT_SECONDS=10
AI4SEC_PIPELINE_JOB_LEASE_SECONDS=45
