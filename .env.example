# Copy to .env for local development. Never place the token value in this file.
# News and other platform model calls use the generic OpenAI-compatible profile.
# Keep secrets only in the local .env or deployment secret injection.
AI4SEC_MODEL_PROVIDER=AI4SEC_OPENAI
AI4SEC_OPENAI_BASE_URL=
AI4SEC_OPENAI_API_KEY=
AI4SEC_OPENAI_MODEL=glm-5.2
AI4SEC_CONFIGURED_MODEL_TIMEOUT_SECONDS=180
AI4SEC_CONFIGURED_MODEL_MAX_OUTPUT_TOKENS=8192

# ASIS base_url is configured in configs/news.yaml. Override it here only when
# the deployment endpoint differs; credentials are always environment secrets.
ASIS_BASE_URL=
ASIS_USERNAME=
ASIS_PASSWORD=

# The path must point to a regular 0600 file visible at the same absolute path
# to both the Repro Worker and the host Docker daemon.
REPRO_MODEL_TOKEN_FILE=/var/lib/ai4sec/secrets/repro_model_token
REPRO_LLM_BASE_URL=https://your-managed-model-gateway.example/v1
REPRO_LLM_MODEL=glm-5.2
REPRO_IMAGE=repro-runner:v4

# Capability reproduction resource limits.
REPRO_CPUS=2.0
REPRO_MEMORY=4g
REPRO_MEMORY_SWAP=4g
REPRO_PIDS_LIMIT=1024

# After the normal execution deadline, allow the agent to finish emitting a
# structured report. A report produced in this window still passes the same
# acceptance checks; Web tasks without one are downgraded to partial.
REPRO_REPORT_GRACE_TIMEOUT=600

# Leave empty for same-origin deployments. When a separate trusted frontend
# origin is required, use a comma-separated list without paths or wildcards.
AI4SEC_CORS_ALLOWED_ORIGINS=

# Production Compose services must share one non-root UID/GID and mount this
# host directory as the persistent data volume. Keep both paths absolute and
# on a local Linux filesystem; do not place the active WAL database on NFS.
# AI4SEC_OUTPUT_DIR=/var/lib/ai4sec/data
# AI4SEC_DATABASE_PATH=/var/lib/ai4sec/data/sqlite/ai4sec_platform.db

# Readiness uses a rolled-back real database write with a short lock timeout.
AI4SEC_READINESS_WRITE_TIMEOUT_MS=1000

# SQLite automatically runs a passive checkpoint after this many WAL pages.
# Keep this positive; periodic maintenance still performs integrity checks and
# records lock/checkpoint metrics independently.
AI4SEC_SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
AI4SEC_DATABASE_MAINTENANCE_REPORT_RETENTION_DAYS=30

# Optional PEM CA bundle for threat live connectors; empty uses system trust roots.
AI4SEC_THREAT_CA_BUNDLE=

# SQLite backup retention: all daily backups for 7 days, then one per week for
# 4 weeks and one per month for 6 months. Backups still need an external disk.
AI4SEC_BACKUP_DAILY_RETENTION_DAYS=7
AI4SEC_BACKUP_WEEKLY_RETENTION_WEEKS=4
AI4SEC_BACKUP_MONTHLY_RETENTION_MONTHS=6

# Pipeline Worker renews each running job lease on heartbeat. Lease is forced
# to at least three heartbeat intervals to avoid transient SQLite stalls.
AI4SEC_PIPELINE_WORKER_HEARTBEAT_SECONDS=10
AI4SEC_PIPELINE_JOB_LEASE_SECONDS=300
